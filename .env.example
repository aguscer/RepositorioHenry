# ─── Servidor ──────────────────────────────────────────────────────────────
PORT=3000

# ─── Proveedor de WhatsApp ─────────────────────────────────────────────────
# "cloud" = WhatsApp Cloud API oficial de Meta (produccion)
# "mock"  = simulador por consola, para probar sin cuenta de Meta
WHATSAPP_PROVIDER=mock

# ─── WhatsApp Cloud API (solo si WHATSAPP_PROVIDER=cloud) ──────────────────
# Se sacan de developers.facebook.com > tu app > WhatsApp > Configuracion
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Lo inventas vos y lo pegas igual en el panel de Meta al configurar el webhook
WHATSAPP_VERIFY_TOKEN=cambiame-por-algo-secreto
# App Secret de la app de Meta: sirve para validar la firma de los webhooks
WHATSAPP_APP_SECRET=

# ─── Panel del cajero ──────────────────────────────────────────────────────
# Clave para entrar al panel /caja. Cambiala si el panel queda expuesto a internet.
PANEL_CLAVE=caja1234

# ─── Comportamiento del bot ────────────────────────────────────────────────
# Minutos que el bot se queda callado en una conversacion despues de que
# el pedido pasa al cajero (para que no pise la charla con la persona)
MINUTOS_PAUSA_BOT=120
